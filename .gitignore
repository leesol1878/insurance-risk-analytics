echo "# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env
.venv
*.egg-info/
dist/
build/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# VS Code
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# DVC (cache and temp files only - NOT the .dvc files)
.dvc/cache/
.dvc/tmp/

# Logs
*.log

# The actual data files (tracked by DVC)
data/*.csv
data/*.txt

# But NOT the .dvc files (we want to track these in Git)
# .dvc files are tracked normally

# Virtual environment
venv/
" > .gitignore